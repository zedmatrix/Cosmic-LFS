      <bridgehead renderas="sect3">Cosmic-viewer Dependencies</bridgehead>
      <bridgehead renderas="sect4">Required</bridgehead>
          <para>rustc, cargo-c, libheif, hicolor-icon-theme,
            libjpeg-turbo, libxkbcommon, libde265, and dav1d</para>

    </sect2>

      <sect2 role="installation">
        <title>Installation of Cosmic-viewer</title>

    <para>Prepare Cosmic-viewer for compilation:</para>

      <para>Now Configure the Package, issue:</para>

        <screen><userinput remap="configure">sed -i -e '/^  "embedded-libheif",$/d' Cargo.toml &amp;&amp;
cargo update --offline --workspace</userinput></screen>

      <para>To Build the Package, issue:</para>

        <screen><userinput remap="make">export TURBOJPEG_SOURCE=pkg-config &amp;&amp;
export TURBOJPEG_DYNAMIC=1 &amp;&amp;

cargo build --release --offline</userinput></screen>

      <para>Now Install the Package, issue:</para>

        <screen><userinput remap="install">install -vDm755 target/release/cosmic-viewer /usr/bin/cosmic-viewer &amp;&amp;

install -vDm644 res/com.system76.CosmicViewer.desktop \
  /usr/share/applications/com.system76.CosmicViewer.desktop &amp;&amp;

install -vDm644 res/com.system76.CosmicViewer.metainfo.xml \
  /usr/share/metainfo/com.system76.CosmicViewer.metainfo.xml &amp;&amp;

cp -rv res/icons/hicolor/. /usr/share/icons/hicolor/
</userinput></screen>

        <screen><userinput remap="post">gtk-update-icon-cache -qtf /usr/share/icons/hicolor</userinput></screen>

      </sect2>

