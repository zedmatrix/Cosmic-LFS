      <bridgehead renderas="sect3">Pop-launcher Dependencies</bridgehead>
      <bridgehead renderas="sect4">Required</bridgehead>
          <para>rustc, cargo-c, libqalculate, dbus, mesa, libxkbcommon,
            xdg-utils, and pop-icon-theme</para>

    </sect2>

      <sect2 role="installation">
        <title>Installation of Pop-launcher</title>

    <para>Prepare Pop-launcher for compilation:</para>

      <para>Now Configure the Package, issue:</para>

        <screen><userinput remap="configure">cargo fetch --locked</userinput></screen>

      <para>To Compile the Package, issue:</para>

        <screen><userinput remap="make">cargo build --release -p pop-launcher-bin</userinput></screen>

      <para>Now Install the Package, issue:</para>

        <screen><userinput remap="install">install -vDm755 target/release/pop-launcher-bin /usr/bin/pop-launcher &amp;&amp;

(cd scripts &amp;&amp; find . -type f -exec install -Dm755 {} /usr/share/pop-launcher/scripts/{} \;) &amp;&amp;

for p in calc cosmic_toplevel desktop_entries files find pop_shell pulse recent scripts terminal web; do
  install -vdm755 "/usr/lib/pop-launcher/plugins/$p"
  install -vm644 plugins/src/"$p"/*.ron "/usr/lib/pop-launcher/plugins/$p"/
  ln -vsfr /usr/bin/pop-launcher "/usr/lib/pop-launcher/plugins/$p/${p/_/-}"
done</userinput></screen>

      </sect2>

