      <bridgehead renderas="sect3">Cosmic-files Dependencies</bridgehead>
      <bridgehead renderas="sect4">Required</bridgehead>
          <para>rustc, cargo-c, glib, xdg-utils, gvfs, cosmic-icons, and libxkbcommon</para>

    </sect2>

      <sect2 role="installation">
        <title>Installation of Cosmic-files</title>

        <para>To Prepare the Package, issue:</para>

        <para>Fetch the dependencies, ensuring the exact versions recorded in the
          existing <filename>Cargo.lock</filename> file are used:</para>

        <screen><userinput remap="configure">cargo fetch --locked</userinput></screen>

      <para>To Build the Package, issue:</para>

        <screen><userinput remap="make">export VERGEN_GIT_COMMIT_DATE='Tue Oct 20 17:40:58 2026 +0200' &amp;&amp;
export VERGEN_GIT_SHA=3cc4b8003e8d08349c7ced8a9cdd10cdfa45d38c &amp;&amp;
export LOCKSTEP_XML_PATH="${PWD}/vendor/atspi-common/xml" &amp;&amp;

cargo build --release
cargo build --release --package cosmic-files-applet
cargo build --release --package cosmic-files-thumbnailer</userinput></screen>

      <para>Now Install the Package, issue:</para>

        <screen><userinput remap="install">install -vDm755 target/release/cosmic-files /usr/bin/cosmic-files &amp;&amp;
install -vDm755 target/release/cosmic-files-applet /usr/bin/cosmic-files-applet &amp;&amp;
install -vDm755 target/release/cosmic-files-thumbnailer /usr/bin/cosmic-files-thumbnailer &amp;&amp;

install -vDm644 target/xdgen/com.system76.CosmicFiles.desktop \
  /usr/share/applications/ &amp;&amp;

install -vDm644 target/xdgen/com.system76.CosmicFiles.metainfo.xml \
  /usr/share/metainfo/ &amp;&amp;

install -vDm644 res/com.system76.CosmicFiles.thumbnailer \
  /usr/share/thumbnailers &amp;&amp;

cp -rv res/icons/hicolor/* /usr/share/icons/hicolor/
</userinput></screen>

        <screen><userinput remap="post">unset VERGEN_GIT_COMMIT_DATE VERGEN_GIT_SHA LOCKSTEP_XML_PATH</userinput></screen>

      </sect2>

