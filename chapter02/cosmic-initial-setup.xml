    <sect2 role="package">
      <title/>

      <para>initial setup program for COSMIC DE</para>

      <bridgehead renderas="sect3">Package Information</bridgehead>

      <itemizedlist spacing="compact">
        <listitem>
          <para>Download HTTP: <ulink url="&cosmic-initial-setup-url;"/></para>
        </listitem>

        <listitem>
          <para>Download SHA256 Sum: &cosmic-initial-setup-sha256sum;</para>
